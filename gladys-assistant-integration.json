{
  "manifest_version": 1,
  "type": "weather",
  "name": "Environment Canada",
  "description": {
    "en": "Official Environment Canada weather: alerts, air quality (AQHI), humidex and wind chill.",
    "fr": "Météo officielle d’Environnement Canada : alertes, cote air santé, humidex et refroidissement."
  },
  "version": "0.1.0",
  "docker_image": "ghcr.io/lm1lc3n7/gladys-environment-canada:0.1.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/LM1LC3N7/gladys-environment-canada/main/cover.png",
  "categories": ["environment"],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Environment Canada weather",
        "fr": "Météo d’Environnement Canada"
      },
      "description": {
        "en": "The official forecasts of Environment and Climate Change Canada for the location of your house in Gladys: nothing to enter, no account, no key. Canada only. The data come from the open Meteorological Service of Canada services (Open Government Licence – Canada); this integration is not affiliated with the Government of Canada.",
        "fr": "Les prévisions officielles d’Environnement et Changement climatique Canada pour la position de votre maison dans Gladys : rien à saisir, ni compte ni clé. Canada seulement. Les données viennent des services ouverts du Service météorologique du Canada (Licence du gouvernement ouvert – Canada) ; cette intégration n’est pas affiliée au gouvernement du Canada."
      },
      "links": [
        {
          "url": "https://meteo.gc.ca",
          "label": {
            "en": "Environment Canada weather",
            "fr": "Météo d’Environnement Canada"
          }
        },
        {
          "url": "https://www.canada.ca/en/environment-climate-change/services/air-quality-health-index.html",
          "label": {
            "en": "About the Air Quality Health Index",
            "fr": "À propos de la cote air santé"
          }
        }
      ]
    },
    {
      "key": "official_alerts",
      "type": "boolean",
      "label": {
        "en": "Official alerts",
        "fr": "Alertes officielles"
      },
      "description": {
        "en": "Warnings, watches, advisories and statements of Environment Canada for your house, air quality and wildfire smoke statements included. They feed the weather widget and the core “weather alert” scene trigger.",
        "fr": "Avertissements, veilles, avis et bulletins d’Environnement Canada pour votre maison, y compris les bulletins sur la qualité de l’air et la fumée des feux de forêt. Ils alimentent le widget météo et le déclencheur de scène « alerte météo »."
      },
      "default": true
    },
    {
      "key": "air_quality_alerts",
      "type": "boolean",
      "label": {
        "en": "Air quality alerts (AQHI)",
        "fr": "Alertes de qualité de l’air (cote air santé)"
      },
      "description": {
        "en": "Adds an alert when the Air Quality Health Index of your area reaches a high risk (7 or more). Not an official alert: it comes from the index itself.",
        "fr": "Ajoute une alerte quand la cote air santé de votre secteur atteint un risque élevé (7 ou plus). Ce n’est pas une alerte officielle : elle découle de la cote elle-même."
      },
      "default": false
    },
    {
      "key": "feels_like_alerts",
      "type": "boolean",
      "label": {
        "en": "Feels-like alerts (estimates)",
        "fr": "Alertes de ressenti (estimations)"
      },
      "description": {
        "en": "Adds an alert when the humidex or the wind chill computed by the integration reaches a real risk. Not official: they mix with the Environment Canada alerts.",
        "fr": "Ajoute une alerte quand l’humidex ou le refroidissement éolien calculé par l’intégration atteint un risque réel. Non officielles : elles se mêlent aux alertes d’Environnement Canada."
      },
      "default": false
    },
    {
      "key": "radar_image",
      "type": "boolean",
      "label": {
        "en": "Precipitation radar",
        "fr": "Radar de précipitations"
      },
      "description": {
        "en": "Environment Canada radar around your house, shown in the weather widget when its “provider images” option is on.",
        "fr": "Radar d’Environnement Canada autour de votre maison, affiché par le widget météo quand son option « images du fournisseur » est activée."
      },
      "default": true
    }
  ],
  "actions": [
    {
      "key": "test_sources",
      "label": {
        "en": "Test Environment Canada",
        "fr": "Tester Environnement Canada"
      },
      "timeout_seconds": 30
    }
  ],
  "scene_triggers": [
    {
      "key": "feels_like_level_changed",
      "label": {
        "en": "Feels-like level changed",
        "fr": "Niveau de ressenti changé"
      },
      "description": {
        "en": "The humidex or the wind chill at a house reached a new Environment Canada risk level.",
        "fr": "L’humidex ou le refroidissement éolien d’une maison a atteint un nouveau niveau de risque d’Environnement Canada."
      },
      "fields": [
        {
          "key": "level",
          "type": "select",
          "label": {
            "en": "Level reached",
            "fr": "Niveau atteint"
          },
          "description": {
            "en": "Empty: any level. Fires even when the index jumps over this level.",
            "fr": "Vide : tous les niveaux. Se déclenche même si l’indice saute ce niveau."
          },
          "options": [
            {
              "value": "cold_extreme",
              "label": {
                "en": "Extreme cold (wind chill ≤ −55)",
                "fr": "Froid extrême (refroidissement ≤ −55)"
              }
            },
            {
              "value": "cold_severe",
              "label": {
                "en": "Severe cold (−48 to −54)",
                "fr": "Froid grave (−48 à −54)"
              }
            },
            {
              "value": "cold_very_high",
              "label": {
                "en": "Very high cold (−40 to −47)",
                "fr": "Froid très élevé (−40 à −47)"
              }
            },
            {
              "value": "cold_high",
              "label": {
                "en": "High cold (−28 to −39)",
                "fr": "Froid élevé (−28 à −39)"
              }
            },
            {
              "value": "cold_moderate",
              "label": {
                "en": "Moderate cold (−10 to −27)",
                "fr": "Froid modéré (−10 à −27)"
              }
            },
            {
              "value": "comfortable",
              "label": {
                "en": "Low risk",
                "fr": "Risque faible"
              }
            },
            {
              "value": "heat_discomfort",
              "label": {
                "en": "Some discomfort (humidex 30 to 39)",
                "fr": "Inconfort (humidex 30 à 39)"
              }
            },
            {
              "value": "heat_great_discomfort",
              "label": {
                "en": "Great discomfort (humidex 40 to 45)",
                "fr": "Grand inconfort (humidex 40 à 45)"
              }
            },
            {
              "value": "heat_danger",
              "label": {
                "en": "Dangerous (humidex 46 to 53)",
                "fr": "Dangereux (humidex 46 à 53)"
              }
            },
            {
              "value": "heat_stroke",
              "label": {
                "en": "Heat stroke imminent (humidex ≥ 54)",
                "fr": "Coup de chaleur imminent (humidex ≥ 54)"
              }
            }
          ]
        },
        {
          "key": "direction",
          "type": "select",
          "label": {
            "en": "Direction",
            "fr": "Sens"
          },
          "options": [
            {
              "value": "worsening",
              "label": {
                "en": "Getting worse",
                "fr": "Aggravation"
              }
            },
            {
              "value": "improving",
              "label": {
                "en": "Getting better",
                "fr": "Amélioration"
              }
            }
          ]
        },
        {
          "key": "house",
          "type": "string",
          "label": {
            "en": "House",
            "fr": "Maison"
          },
          "description": {
            "en": "Exact name of the house in Gladys. Empty: every house.",
            "fr": "Nom exact de la maison dans Gladys. Vide : toutes les maisons."
          },
          "placeholder": {
            "en": "e.g. Home",
            "fr": "ex. Maison"
          }
        }
      ],
      "variables": [
        {
          "key": "level",
          "type": "string",
          "label": {
            "en": "Level reached",
            "fr": "Niveau atteint"
          }
        },
        {
          "key": "direction",
          "type": "string",
          "label": {
            "en": "Direction",
            "fr": "Sens"
          }
        },
        {
          "key": "previous_level",
          "type": "string",
          "label": {
            "en": "Previous level",
            "fr": "Niveau précédent"
          }
        },
        {
          "key": "current_level",
          "type": "string",
          "label": {
            "en": "Current level",
            "fr": "Niveau actuel"
          }
        },
        {
          "key": "index",
          "type": "string",
          "label": {
            "en": "Index (humidex, wind_chill)",
            "fr": "Indice (humidex, wind_chill)"
          }
        },
        {
          "key": "value",
          "type": "number",
          "label": {
            "en": "Index value",
            "fr": "Valeur de l’indice"
          }
        },
        {
          "key": "unit",
          "type": "string",
          "label": {
            "en": "Unit",
            "fr": "Unité"
          }
        },
        {
          "key": "house",
          "type": "string",
          "label": {
            "en": "House",
            "fr": "Maison"
          }
        },
        {
          "key": "summary",
          "type": "string",
          "label": {
            "en": "Summary",
            "fr": "Résumé"
          }
        }
      ]
    },
    {
      "key": "air_quality_level_changed",
      "label": {
        "en": "Air quality level changed",
        "fr": "Niveau de qualité de l’air changé"
      },
      "description": {
        "en": "The Air Quality Health Index of a house reached a new risk level.",
        "fr": "La cote air santé d’une maison a atteint un nouveau niveau de risque."
      },
      "fields": [
        {
          "key": "level",
          "type": "select",
          "label": {
            "en": "Level reached",
            "fr": "Niveau atteint"
          },
          "description": {
            "en": "Empty: any level. Fires even when the index jumps over this level.",
            "fr": "Vide : tous les niveaux. Se déclenche même si la cote saute ce niveau."
          },
          "options": [
            {
              "value": "low",
              "label": {
                "en": "Low risk (1 to 3)",
                "fr": "Risque faible (1 à 3)"
              }
            },
            {
              "value": "moderate",
              "label": {
                "en": "Moderate risk (4 to 6)",
                "fr": "Risque modéré (4 à 6)"
              }
            },
            {
              "value": "high",
              "label": {
                "en": "High risk (7 to 10)",
                "fr": "Risque élevé (7 à 10)"
              }
            },
            {
              "value": "very_high",
              "label": {
                "en": "Very high risk (above 10)",
                "fr": "Risque très élevé (plus de 10)"
              }
            }
          ]
        },
        {
          "key": "direction",
          "type": "select",
          "label": {
            "en": "Direction",
            "fr": "Sens"
          },
          "options": [
            {
              "value": "worsening",
              "label": {
                "en": "Getting worse",
                "fr": "Aggravation"
              }
            },
            {
              "value": "improving",
              "label": {
                "en": "Getting better",
                "fr": "Amélioration"
              }
            }
          ]
        },
        {
          "key": "house",
          "type": "string",
          "label": {
            "en": "House",
            "fr": "Maison"
          },
          "description": {
            "en": "Exact name of the house in Gladys. Empty: every house.",
            "fr": "Nom exact de la maison dans Gladys. Vide : toutes les maisons."
          },
          "placeholder": {
            "en": "e.g. Home",
            "fr": "ex. Maison"
          }
        }
      ],
      "variables": [
        {
          "key": "level",
          "type": "string",
          "label": {
            "en": "Level reached",
            "fr": "Niveau atteint"
          }
        },
        {
          "key": "direction",
          "type": "string",
          "label": {
            "en": "Direction",
            "fr": "Sens"
          }
        },
        {
          "key": "previous_level",
          "type": "string",
          "label": {
            "en": "Previous level",
            "fr": "Niveau précédent"
          }
        },
        {
          "key": "current_level",
          "type": "string",
          "label": {
            "en": "Current level",
            "fr": "Niveau actuel"
          }
        },
        {
          "key": "value",
          "type": "number",
          "label": {
            "en": "AQHI",
            "fr": "Cote air santé"
          }
        },
        {
          "key": "station",
          "type": "string",
          "label": {
            "en": "AQHI community",
            "fr": "Secteur de la cote"
          }
        },
        {
          "key": "house",
          "type": "string",
          "label": {
            "en": "House",
            "fr": "Maison"
          }
        },
        {
          "key": "summary",
          "type": "string",
          "label": {
            "en": "Summary",
            "fr": "Résumé"
          }
        }
      ]
    }
  ],
  "widgets": [
    {
      "key": "feels_like",
      "label": {
        "en": "Feels like",
        "fr": "Ressenti"
      },
      "description": {
        "en": "Humidex or wind chill with its risk level, worst hour, frostbite time, black ice.",
        "fr": "Humidex ou refroidissement et son niveau de risque, pire heure, gelure, verglas."
      },
      "icon": "thermometer",
      "settings": [
        {
          "key": "house",
          "type": "string",
          "label": {
            "en": "House",
            "fr": "Maison"
          },
          "description": {
            "en": "Name of the house in Gladys. Empty: the first located house.",
            "fr": "Nom de la maison dans Gladys. Vide : la première maison localisée."
          },
          "placeholder": {
            "en": "e.g. Home",
            "fr": "ex. Maison"
          }
        }
      ]
    },
    {
      "key": "air_quality",
      "label": {
        "en": "Air quality",
        "fr": "Qualité de l’air"
      },
      "description": {
        "en": "Air Quality Health Index, risk level and advice, 24-hour forecast, wildfire smoke.",
        "fr": "Cote air santé, niveau de risque et conseils, prévision sur 24 h, fumée des feux de forêt."
      },
      "icon": "wind",
      "settings": [
        {
          "key": "house",
          "type": "string",
          "label": {
            "en": "House",
            "fr": "Maison"
          },
          "description": {
            "en": "Name of the house in Gladys. Empty: the first located house.",
            "fr": "Nom de la maison dans Gladys. Vide : la première maison localisée."
          },
          "placeholder": {
            "en": "e.g. Home",
